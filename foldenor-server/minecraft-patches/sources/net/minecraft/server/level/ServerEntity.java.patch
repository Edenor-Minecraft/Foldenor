+    private boolean isNullMovePacket(Packet<?> packet) {
+        if (!(packet instanceof ClientboundMoveEntityPacket move)) return false;
+        return switch (packet) {
+            case ClientboundMoveEntityPacket.Pos ignored -> move.getXa() == 0 && move.getYa() == 0 && move.getZa() == 0;
