+    private void saveCrashReport(final Throwable throwable, final String title, final CrashReportCategoryFiller filler) {
+        final MinecraftServer server = MinecraftServer.getServer();
+        if (server == null) {
+            return;
+        }
+
+        final CrashReport report = CrashReport.forThrowable(throwable, title);
+        filler.fill(report);
+        server.fillSystemReport(report.getSystemReport());
+
+        final Path path = server.getServerDirectory().resolve("crash-reports")
+            .resolve("crash-" + net.minecraft.util.Util.getFilenameFormattedDateTime() + "-server.txt");
+        if (report.saveToFile(path, ReportType.CRASH)) {
+            LOGGER.error("Crash report saved to: {}", path.toAbsolutePath());
+        } else {
+            LOGGER.error("Unable to save crash report to disk");
+        }
+    }
+
